<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_picking_form_dock_resource_booking" model="ir.ui.view">
        <field name="name">stock.picking.form.dock.resource.booking</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Dock Reservation">
                    <field name="booking_id" options="{'no_create': False}" />
                    <field name="transporter_id" />
                    <field name="transport_type" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_tree_dock_resource_booking" model="ir.ui.view">
        <field name="name">stock.picking.tree.dock.resource.booking</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="booking_id" />
                <field name="transporter_id" />
                <field name="transport_type" />
            </xpath>
        </field>
    </record>
</odoo>
